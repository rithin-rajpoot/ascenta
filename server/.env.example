# Ascenta — Backend Environment Variables (Example)
# Copy to `.env` and replace with real values. Never commit real secrets.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ascenta
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Optional: must match INTERNAL_API_KEY in the AI service.
AI_SERVICE_KEY=your_internal_service_key_here