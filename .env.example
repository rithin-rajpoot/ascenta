# ============================================
# Ascenta — Root Environment Variables (Example)
# Copy this file and rename to `.env` at the location required by each service.
# Replace placeholder values with real values. Never commit real secrets.
# ============================================

# --- Backend (server/.env) ---
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ascenta
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# --- Frontend (client/.env) ---
VITE_API_URL=http://localhost:5000/api

# --- AI Service (ai-service/.env) ---
GEMINI_API_KEY=your_gemini_api_key_here