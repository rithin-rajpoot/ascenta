# Ascenta — AI Service Environment Variables (Example)
# Copy to `.env` and replace with real values. Never commit real secrets.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional shared secret. When set, only the backend (which sends the
# X-Internal-Key header) may call the AI endpoints.
INTERNAL_API_KEY=your_internal_service_key_here

# Comma-separated list of browser origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000