# Ascenta — Backend Environment Variables (Example)
# Copy to `.env` and replace with real values. Never commit real secrets.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ascenta
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000